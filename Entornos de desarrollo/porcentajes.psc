Proceso porcentajes
	Definir H , M , total Como Entero;
	Definir Ph ,Pm Como Real;
	Escribir "Indique el número de mujeres";
	Leer M;
	Escribir "Indique el número de hombres";
	Leer H;
	total <- H + M;
	Ph <- (H * 100)/total;
	Pm <- (M * 100)/total;
	Escribir "El porcentaje de Mujeres es: ", Pm;
	Escribir "El porcentaje de Hombres es: ", Ph;
	
	
	
FinProceso
