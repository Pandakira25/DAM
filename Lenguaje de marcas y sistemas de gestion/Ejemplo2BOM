        <script type="text/javascript">
            let nuevaVentana;
            function miRuta(){
                document.write('Ruta: ' + window.location.href + '<br><br><br><br>');
            }

            window.onload = miRuta();
            ventanaNueva = window.open('abrecierra.html', "Nueva", 'widht=300, height=300, resizable=yes, self=yes')
            confirm('Mover y cambiar de tamaño la ventana');
