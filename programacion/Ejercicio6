#include <iostream>

using namespace std;

int main()
{

    float L1;
    float L2;
    float L3;
    int n; //cantidad de triangulos
    int TI = 0; //triangulos isoceles
    int TEQ = 0; //triangulos equilateros
    int TES = 0; //triangulos escalenos

    cout << "escribe el numero de triangulos" << endl;
    cin >> n;

    while (n > 0)
    {
        cout << "Lado 1" << endl;
        cin >> L1;

        cout << "Lado 2" << endl;
        cin >> L2;

        cout << "Lado 3" << endl;
        cin >> L3;

        if (L1 == L2 && L2 == L3)
        {
            cout << "es equilatero" << endl;
            TEQ = TEQ + 1;
        }
        else
        {
            if (L1 != L2 && L2 != L3 && L1 != L3)
            {

                cout << "es escaleno" << endl;
                TES = TES + 1;
            }
            else
            {
                cout << "es isoceles" << endl;
                TI = TI + 1;
            }
        }
        n = n - 1;
    }

    cout << "La cantidad de isoceles es:" << TI << endl;
    cout << "La cantidad de equilateros es:" << TEQ << endl;
    cout << "La cantidad de escalenos es:" << TES << endl;
}